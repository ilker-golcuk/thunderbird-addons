	"mailmerge.delivermodewarning.title" : { "message" : "Versandmodus-Warnung" },
	"mailmerge.delivermodewarning.message" : { "message" : "Die Verwendung von \"Jetzt senden\" als \"Versandmodus\" erfolgt auf eigene Gefahr!\n\nEs wird nachdrücklich empfohlen \"Später senden\" als \"Versandmodus\" zu verwenden und die individuellen und personalisierten Nachrichten im Ordner \"Lokale Ordner -> Postausgang\" zu überprüfen. Fehler in Thunderbird, Fehler in Mail Merge und Fehler in anderen Add-ons können zu unerwarteten und unerwünschten Ergebnissen führen." },
	
	"mailmerge.recipientsreminder.title" : { "message" : "Empfänger-Erinnerung" },
	"mailmerge.recipientsreminder.message" : { "message" : "Die Nachricht enthält mehrere Empfänger.\n\nDie \"Empfänger-Erinnerung\" soll das versehentliche Klicken auf \"Jetzt senden\" oder \"Später senden\" verhindern. Um Mail Merge zu starten, klicken Sie bitte auf \"Abbrechen\" und verwenden Sie den Eintrag im Menü \"Extras -> Mail Merge\" oder die Schaltfläche in der Symbolleiste \"Mail Merge\"." },
	
	"mailmerge.variablesreminder.title" : { "message" : "Variablen-Erinnerung" },
	"mailmerge.variablesreminder.message" : { "message" : "Die Nachricht enthält Variablen.\n\nDie \"Variablen-Erinnerung\" soll das versehentliche Klicken auf \"Jetzt senden\" oder \"Später senden\" verhindern. Um Mail Merge zu starten, klicken Sie bitte auf \"Abbrechen\" und verwenden Sie den Eintrag im Menü \"Extras -> Mail Merge\" oder die Schaltfläche in der Symbolleiste \"Mail Merge\"." },
	
