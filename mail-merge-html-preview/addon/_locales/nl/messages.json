	"mailmerge.delivermodewarning.title" : { "message" : "Verzendmoduswaarschuwing" },
	"mailmerge.delivermodewarning.message" : { "message" : "Gebruik \"Nu verzenden\" of \"Verzendmodus\" op je eigen risico!\n\nHet wordt sterk aangeraden om \"Later verzenden\" te gebruiken als \"Verzendmodus\" en om de individuele of gepersonaliseerde berichten te controleren in \"Lokale mappen -> Postvak uit\". Bugs in Thunderbird, bugs in Mail Merge en bugs in andere add-ons kunnen leiden tot onverwachte en ongewenste resultaten." },
	
	"mailmerge.recipientsreminder.title" : { "message" : "Ontvangersherinnering" },
	"mailmerge.recipientsreminder.message" : { "message" : "Deze mail bevat meerdere ontvangers.\n\nDe \"Ontvangersherinnering\" zal voorkomen dat je per ongeluk zal klikken op \"Nu verzenden\" of \"Later verzenden\". Om Mail Merge te starten klik op \"Annuleren\" en gebruik het menu \"Extra -> Mail Merge\" of de werkbalkknop \"Mail Merge\"." },
	
	"mailmerge.variablesreminder.title" : { "message" : "Variabelenherinnering" },
	"mailmerge.variablesreminder.message" : { "message" : "Deze mail bevat variabelen.\n\nDe \"Variabelenherinnering\" zal voorkomen dat je per ongeluk zal klikken op \"Nu verzenden\" of \"Later verzenden\". Om Mail Merge te starten klik op \"Annuleren\" en gebruik het menu \"Extra -> Mail Merge\" of de werkbalkknop \"Mail Merge\"." },
	
	"mailmerge.notifications.finished" : { "message" : "Mail Merge heeft zijn taak volbracht.\n$1 berichten verwerkt in $2." }
	
