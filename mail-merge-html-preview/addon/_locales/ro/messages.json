	"mailmerge.delivermodewarning.title" : { "message" : "Alertă Mod de Livrare" },
	"mailmerge.delivermodewarning.message" : { "message" : "Foloseste \"Trimite Acum\" ca \"Mod de Livrare\" pe risc propiu!\n\nEste recomandat utilizarea \"Trimite mai Târziu\" ca \"Mod de Livrare\" și pentru a verifica mesajele individuale și personalizate în dosarul \"Dosare Locale -> Căsuța de Ieșire\". Erorile de Thunderbird, erorile de Mail Merge și erorile altor addons pot provoca rezultate neașteptate și nedorite." },
	
	"mailmerge.recipientsreminder.title" : { "message" : "Amintire Destinatari" },
	"mailmerge.recipientsreminder.message" : { "message" : "Mesajul conține mai mulți destinatari.\n\nEl \"Amintire Destinatari\" vă va împiedica să faceți clic accidental pe \"Trimite Acum\" sau \"Trimite mai Târziu\". Pentru a porni Mail Merge faceti click pe \"Anulare\" si utilizati optiunea din meniul \"Instrumente -> Mail Merge\" sau butonul din bara de instrumente \"Mail Merge\"." },
	
	"mailmerge.variablesreminder.title" : { "message" : "Amintire Variabile" },
	"mailmerge.variablesreminder.message" : { "message" : "Mesajul conține variabile.\n\nEl \"Amintire Variabile\" vă va împiedica să faceți clic accidental pe \"Trimite Acum\" sau \"Trimite mai Târziu\". Pentru a porni Mail Merge faceti click pe \"Anulare\" si utilizati optiunea din meniul \"Instrumente -> Mail Merge\" sau butonul din bara de instrumente \"Mail Merge\"." },
	
