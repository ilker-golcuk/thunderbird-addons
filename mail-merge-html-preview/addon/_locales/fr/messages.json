	"mailmerge.delivermodewarning.title" : { "message" : "Avertissement sur le mode de livraison" },
	"mailmerge.delivermodewarning.message" : { "message" : "Utilisez \"Envoyer maintenant\" comme \"Mode de livraison\" à vos propres risques!\n\nIl est grandement recommandé d'utiliser \"Envoyer plus tard\" comme \"Mode de livraison\" ainsi que de vérifier tous les messages générés dans le dossier \"Dossiers locaux -> Messages en attente\". Les bugs de Thunderbird, de Mail Merge ou d'autres add-ons peuvent conduire à des résultats inattendus et non désirés." },
	
