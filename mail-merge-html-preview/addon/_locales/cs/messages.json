	"mailmerge.delivermodewarning.title" : { "message" : "Varování ohledně typu doručení" },
	"mailmerge.delivermodewarning.message" : { "message" : "\"Odeslat nyní\" použijte jako \"Režim doručení\" na vlastní nebezpečí!\n\nJe velmi doporučeno, abyste použili \"Režim doručení\" \"Odeslat později\" a abyste jednotlivé přizpůsobené zprávy ve složce \"Místní složky -> Pošta k odeslání\" před odesláním ručně zkontrolovali. K chybám v Thunderbirdu, Mail Merge, i dalších doplňcích dochází a může to potenciálně vést k nežádoucím výsledkům." },
	
	"mailmerge.recipientsreminder.title" : { "message" : "Upozornění na příjemce" },
	"mailmerge.recipientsreminder.message" : { "message" : "Zpráva obsahuje vícero příjemců.\n\n\"Upozornění na příjemce\" by vám mělo zabránit omylem kliknout na \"Odeslat nyní\", nebo \"Odeslat později\". Pokud chcete použít Mail Merge, klikněte na \"Zrušit\" a buď použijte položku \"Nástroje -> Mail Merge\", nebo tlačítko \"Mail Merge\" na panelu nástrojů." },
	
	"mailmerge.variablesreminder.title" : { "message" : "Upozornění na proměnné" },
	"mailmerge.variablesreminder.message" : { "message" : "Zpráva obsahuje proměnné.\n\n\"Upozornění na proměnné\" by vám mělo zabránit omylem kliknout na \"Odeslat nyní\", nebo \"Odeslat později\". Pokud chcete použít Mail Merge, klikněte na \"Zrušit\" a buď použijte položku \"Nástroje -> Mail Merge\", nebo tlačítko \"Mail Merge\" na panelu nástrojů." },
	
